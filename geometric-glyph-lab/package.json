{
  "name": "geometric-glyph-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "verify:prebuilt": "node scripts/verify-prebuilt.mjs",
    "verify:curves": "node scripts/verify-curves.mjs",
    "verify:fills": "node scripts/verify-fills.mjs",
    "verify:fill-registry": "node scripts/verify-fill-registry.mjs",
    "generate:base": "node scripts/generate-artifacts.mjs",
    "generate:semantic": "node scripts/generate-semantic-registry.mjs",
    "generate:catalog": "node scripts/generate-straight-catalog.mjs",
    "generate:fills": "node scripts/generate-fill-registry.mjs",
    "generate": "npm run generate:base && npm run generate:semantic && npm run generate:catalog && npm run generate:fills",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "verify:semantic": "node scripts/verify-semantic-registry.mjs",
    "verify:catalog": "node scripts/verify-straight-catalog.mjs",
    "verify": "npm run verify:prebuilt && npm run verify:curves && npm run verify:fills && npm run verify:artifacts && npm run verify:semantic && npm run verify:catalog && npm run verify:fill-registry"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^7.1.3"
  }
}

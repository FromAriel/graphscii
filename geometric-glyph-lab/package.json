{
  "name": "geometric-glyph-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "verify:prebuilt": "node scripts/verify-prebuilt.mjs",
    "generate": "node scripts/generate-artifacts.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "verify": "npm run verify:prebuilt && npm run verify:artifacts"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^7.1.3"
  }
}

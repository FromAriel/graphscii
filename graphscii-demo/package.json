{
  "name": "graphscii-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-assets.mjs && node scripts/assemble-main.mjs",
    "dev": "vite --port 5174",
    "prebuild": "node scripts/sync-assets.mjs && node scripts/assemble-main.mjs",
    "build": "tsc --noEmit && vite build --base=./",
    "precheck": "node scripts/assemble-main.mjs",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "verify:assets": "node scripts/verify-demo.mjs",
    "verify:topology": "node scripts/verify-topology-contract.mjs",
    "verify": "npm run verify:assets && npm run verify:topology && npm run check && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^7.1.3"
  }
}
